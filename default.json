{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":configMigration",
    ":semanticCommits",
    ":semanticCommitScope(deps)",
    "abandonments:recommended",
    "security:minimumReleaseAgeNpm",
    ":pinAllExceptPeerDependencies",
    ":disableRateLimiting",
    ":maintainLockFilesWeekly",
    "group:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "internalChecksAsSuccess": true,
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "3 days",
  "npmrc": "min-release-age=3",
  "npmrcMerge": true,
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ]
    },
    {
      "description": "Handle vulnerabilities immediately",
      "matchUpdateTypes": [
        "vulnerability"
      ],
      "minimumReleaseAge": null,
      "prCreation": "immediate"
    },
    {
      "description": "Mark major version bumps with the breaking label",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "breaking"
      ]
    },
    {
      "description": "Group yboyer/actions updates and bypass stability-days",
      "groupName": "yboyer actions",
      "minimumReleaseAge": null,
      "prCreation": "immediate",
      "matchDepNames": [
        "yboyer/actions/**"
      ],
      "matchManagers": [
        "github-actions",
        "regex"
      ]
    }
  ],
  "platformAutomerge": false,
  "rangeStrategy": "bump",
  "separateMajorMinor": false,
  "vulnerabilityAlerts": {
    "assignees": [
      "yboyer"
    ],
    "branchTopic": "{{{datasource}}}-{{{depNameSanitized}}}-vulnerability",
    "commitMessagePrefix": "[SECURITY]",
    "enabled": true,
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null,
    "prCreation": "immediate"
  }
}
