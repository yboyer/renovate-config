{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "abandonments:recommended",
    "config:recommended",
    "docker:pinDigests",
    "group:recommended",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
    ":automergePatch",
    ":configMigration",
    ":disableRateLimiting",
    ":maintainLockFilesWeekly",
    ":pinAllExceptPeerDependencies",
    ":rebaseStalePrs",
    ":semanticCommits",
    ":semanticCommitScope(deps)",
    ":updateNotScheduled"
  ],
  "internalChecksAsSuccess": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|[\\s\"\\x27])(?<depName>[\\w.-]+(?::\\d+)?(?:/[\\w.-]+)+):(?<currentValue>[\\w.-]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[\\s\"\\x27]|$)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "minimumReleaseAge": "3 days",
  "npmrc": "min-release-age=3",
  "npmrcMerge": true,
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Handle lock file maintenance immediately",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": null,
      "prCreation": "immediate"
    },
    {
      "description": "Mark major version bumps with the breaking label",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "breaking"
      ]
    },
    {
      "description": "Group all patch updates into one PR",
      "groupName": "all patch updates",
      "matchUpdateTypes": [
        "patch"
      ]
    },
    {
      "description": "Group all minor updates into one PR",
      "groupName": "all minor updates",
      "matchUpdateTypes": [
        "minor"
      ]
    },
    {
      "description": "Group yboyer/actions updates and bypass stability-days",
      "groupName": "yboyer actions",
      "minimumReleaseAge": null,
      "prCreation": "immediate",
      "matchPackageNames": [
        "yboyer/actions",
        "yboyer/actions/**"
      ],
      "matchManagers": [
        "github-actions",
        "custom.regex"
      ]
    },
    {
      "description": "Group Biome and shared config updates",
      "matchPackageNames": [
        "@biomejs/biome",
        "@yboyer/config"
      ],
      "matchManagers": [
        "npm"
      ],
      "groupName": "Biome and shared config"
    }
  ],
  "platformAutomerge": false,
  "rangeStrategy": "bump",
  "schedule": [
    "* 0-4 * * *"
  ],
  "separateMajorMinor": false,
  "vulnerabilityAlerts": {
    "assignees": [
      "yboyer"
    ],
    "branchTopic": "{{{datasource}}}-{{{depNameSanitized}}}-vulnerability",
    "commitMessagePrefix": "[SECURITY]",
    "enabled": true,
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null,
    "prCreation": "immediate",
    "npmrc": "min-release-age=0"
  }
}
